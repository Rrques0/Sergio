    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "worker": "tsx lib/observability/worker.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.7.0",
    "@react-pdf/renderer": "^4.3.0",
    "bullmq": "^5.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "^22.0.1",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.15",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.1.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-email": "^4.0.7",
    "resend": "^4.5.1",
    "sharp": "^0.34.1",
    "zod": "^3.25.1"
